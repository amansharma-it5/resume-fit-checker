{
  "name": "resume-lab",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"*.{json,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"*.{json,ts}\"",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --test analysis-engine.test.js rewrite-verification.test.js ai-rewrite-function.test.mjs netlify/functions/account-data.test.mjs && vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:rls": "supabase test db",
    "test:staging": "node scripts/staging-live-test.mjs",
    "check:legacy": "node --check analysis-engine.js && node --check rewrite-verification.js && node --check netlify/functions/ai-rewrite.mjs && node --check netlify/functions/account-data.mjs && node --check netlify/functions/_shared/supabase-admin.mjs",
    "check:refs": "node scripts/check-references.mjs",
    "check:secrets": "node scripts/secret-scan.mjs",
    "check": "pnpm check:legacy && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm check:refs && pnpm check:secrets"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "idb": "^8.0.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "26.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "supabase": "^2.115.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
