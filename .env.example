# Public browser configuration. These values are identifiers, not service-role secrets.
VITE_AUTH_ENABLED=true
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only Netlify Function configuration. Never prefix these with VITE_.
SUPABASE_SERVICE_ROLE_KEY=server-only-placeholder
GROQ_API_KEY=server-only-placeholder
GROQ_MODEL=openai/gpt-oss-20b
# Cloudflare Pages Function only. Never use a VITE_ prefix or expose this value to the browser.
GEMINI_API_KEY=server-only-placeholder
